# Copy to .env and fill in. NEVER commit the real .env.

# Roles (testnet dev keys). CLIENT falls back to PRIVATE_KEY if unset.
PRIVATE_KEY=0xYOUR_CLIENT_DEV_KEY
CLIENT_PRIVATE_KEY=0xYOUR_CLIENT_DEV_KEY
PROVIDER_PRIVATE_KEY=0xYOUR_PROVIDER_DEV_KEY
EVALUATOR_PRIVATE_KEY=0xYOUR_EVALUATOR_DEV_KEY

# Arc testnet
ARC_TESTNET_RPC_URL=https://rpc.testnet.arc.io
ARC_TESTNET_CHAIN_ID=5042002
ARC_TESTNET_EXPLORER=https://explorer.testnet.arc.io

# Arc mainnet (permissioned phase)
ARC_MAINNET_RPC_URL=https://rpc.mainnet.arc.io
ARC_MAINNET_CHAIN_ID=5042
ARC_MAINNET_EXPLORER=https://explorer.arc.io

# Token + native standards (testnet)
USDC_ADDRESS=0x3600000000000000000000000000000000000000
ERC8183_AGENTIC_COMMERCE_TESTNET=0x0747EEf0706327138c69792bF28Cd525089e4583
ERC8004_IDENTITY_TESTNET=0x8004A818BFB912233c491871b3d84c89A494BD9e
ERC8004_REPUTATION_TESTNET=0x8004B663056A597Dffe9eCcC1965A193B7388713
ERC8004_VALIDATION_TESTNET=0x8004Cb1BF31DAf7788923b405b754f57acEB4272
