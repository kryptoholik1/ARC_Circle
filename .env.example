# Copy to .env and fill in your own values. Never commit the real .env.

# --- Dev wallet ---
DEPLOYER_ADDRESS=0xYOUR_DEV_ADDRESS
PRIVATE_KEY=0xYOUR_DEV_PRIVATE_KEY

# --- Arc network (testnet) ---
